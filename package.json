{
  "name": "@amenophis1er/byok",
  "version": "0.1.2",
  "description": "Bring-your-own-key AI for Chrome extensions (MV3): encrypted key storage, sign-in with Claude, ChatGPT and Ollama accounts, Anthropic and OpenAI-compatible providers, tool calling, one message API between the UI and the worker.",
  "keywords": [
    "byok",
    "ai",
    "llm",
    "chrome-extension",
    "manifest-v3",
    "anthropic",
    "claude",
    "openai",
    "chatgpt",
    "ollama",
    "openrouter",
    "tool-calling",
    "api-keys",
    "oauth"
  ],
  "license": "Apache-2.0",
  "author": "Amen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amenophis1er/byok.git"
  },
  "homepage": "https://github.com/amenophis1er/byok#readme",
  "bugs": {
    "url": "https://github.com/amenophis1er/byok/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "default": "./dist/background/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./dnr-rules.json": "./manifest/dnr-rules.json"
  },
  "files": [
    "dist",
    "manifest",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "compile": "tsc --noEmit",
    "example": "npm run build && rm -rf example/demo/lib && cp -R dist example/demo/lib && cp manifest/dnr-rules.json example/demo/rules.json",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "api": "npm run build && node scripts/api-report.mjs",
    "api:update": "npm run build && node scripts/api-report.mjs --update",
    "check": "npm run typecheck && npm test && npm run api",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.20.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "private": false
}
